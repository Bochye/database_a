generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Accounts {
  id        Int      @id @default(autoincrement())
  userid    String   @unique
  password  String
  isadmin   Boolean  @default(false)
  department Department @default(CS)
}

model Items {
  id               Int                @id @default(autoincrement())
  assetCode        String             @unique
  name             String
  modelNumber      String?
  acquisitionDate  DateTime?
  disposalDate     DateTime?
  acquisitionCost  BigInt?
  manager          String?
  location         String?
  status           AssetStatus        @default(USED)
  stock            Int                @default(0)
  ownerid          String
  department       Department         @default(CS)
  createdAt        DateTime           @default(now())

  updatedBy       String?            // 最終更新者のユーザーID
  updatedAt       DateTime           @updatedAt // 保存時に自動で現在時刻が入る

  InventoryRecords InventoryRecords[]
  Requests         Requests[]

  InventoryRequests InventoryRequests[]
}

enum AssetStatus {
  USED
  UNUSED
  UNKNOWN
  DISPOSED
}

enum Department {
  AD
  EE
  ME
  CS
}

// 1. 棚卸しの「実施期間」を管理するテーブルを追加
model InventoryRounds {
  id          Int      @id @default(autoincrement())
  title       String   // 例: "2025年度"
  isCurrent   Boolean  @default(true) // 現在アクティブな棚卸し期間かどうか
  createdAt   DateTime @default(now())
  createdBy   String   // 開始した管理者のID
  records     InventoryRecords[]
}

// 2. 棚卸しの「回答結果」テーブルを修正
model InventoryRecords {
  id          Int      @id @default(autoincrement())
  itemId      Int
  ownerId     String
  roundId     Int      //どの棚卸し期間に対する回答か
  isApproved  Boolean         @default(false)
  status      InventoryRecordStatus @default(PENDING) // 新規追加
  newStock    Int?
  newLocation String?  // 回答時の場所
  newStatus   AssetStatus? // 回答時のステータス
  confirmedAt DateTime @default(now())
  note        String?

  item        Items           @relation(fields: [itemId], references: [id])
  round       InventoryRounds @relation(fields: [roundId], references: [id])

  // 同じ「期間」に「同じ資産」を2度回答できないように制約
  @@unique([itemId, roundId])
}

enum InventoryRecordStatus {
  PENDING            // 送信済み・未処理
  APPROVED           // 適用済み
  RESUBMIT_REQUESTED // 再申請依頼済
}
model Requests {
  id           Int           @id @default(autoincrement())
  itemId       Int
  requesterId  String
  type         RequestType
  status       RequestStatus @default(PENDING)
  note         String?       // 申請者（ユーザー）の備考
  adminNote    String?       // 管理者（Admin）からの備考・回答
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt  
  // 送信ごとの識別番号。再送された同じ送信を1件として扱うために使う。
  clientRequestId String?    @unique
  item         Items         @relation(fields: [itemId], references: [id])
}

model InventoryRequests {
  id          Int      @id @default(autoincrement())
  itemId      Int
  userId      String
  newStatus   String?
  newLocation String?
  note        String?
  status      String   @default("PENDING") // PENDING, APPROVED, RESUBMIT
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  item        Items    @relation(fields: [itemId], references: [id])
}

enum RequestType {
  REPAIR
  DISPOSAL
  SEAL_REISSUE
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}