generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Accounts {
  id        Int      @id @default(autoincrement()) // ID 自動割り振りの番号
  userid    String                                 // 任意のＩＤ（例えば、utsugi.s)みたいな
  password  String                                 // 任意のパスワード
  isadmin      Boolean  @default(false)            // 管理者かどうか
}

model Items{
  id        Int      @id @default(autoincrement())           // ID 自動割り振りの番号（資産コードじゃない） //必須！
  assetCode       String       @unique                       // 資産コード
  name      String                                           // 名前
  modelNumber     String?                                    // 型式（型番）
  acquisitionDate DateTime?                                  // 取得年月日
  disposalDate    DateTime?                                  // 廃棄年月日
  acquisitionCost Float?                                     // 取得価額
  manager         String?                                    // 管理者（使用者）
  location        String?                                    // 管理場所（使用場所）
  status          AssetStatus @default(USED)                 // 資産状態
  stock     Int      @default(0)                             // 個数
  ownerid   String                                           // 所有者のＩＤ
  createdAt DateTime @default(now())                         // データの作成日（取得年月日ではない）
}

enum AssetStatus {
  USED          // 使用中
  UNUSED        // 未使用
  UNKNOWN       // 不明
  DISPOSED      // 除却
}