generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Accounts {
  id        Int      @id @default(autoincrement())
  userid    String
  password  String
  isadmin   Boolean  @default(false)
}

model Items {
  id               Int                @id @default(autoincrement())
  assetCode        String             @unique
  name             String
  modelNumber      String?
  acquisitionDate  DateTime?
  disposalDate     DateTime?
  acquisitionCost  Float?
  manager          String?
  location         String?
  status           AssetStatus        @default(USED)
  stock            Int                @default(0)
  ownerid          String
  createdAt        DateTime           @default(now())

  InventoryRecords InventoryRecords[]
  Requests         Requests[]

  InventoryRequests InventoryRequests[]
}

enum AssetStatus {
  USED
  UNUSED
  UNKNOWN
  DISPOSED
}

model InventoryRecords {
  id         Int      @id @default(autoincrement())
  itemId     Int
  ownerId    String
  confirmedAt DateTime @default(now())
  note       String?
  item       Items    @relation(fields: [itemId], references: [id])
}

model Requests {
  id          Int       @id @default(autoincrement())
  itemId      Int
  requesterId String
  type        RequestType
  status      RequestStatus @default(PENDING)
  note        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  item        Items     @relation(fields: [itemId], references: [id])
}

model InventoryRequests {
  id          Int      @id @default(autoincrement())
  itemId      Int
  userId      String
  newStatus   String?
  newLocation String?
  note        String?
  status      String   @default("PENDING") // PENDING, APPROVED, RESUBMIT
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  item        Items    @relation(fields: [itemId], references: [id])
}

enum RequestType {
  REPAIR
  DISPOSAL
  SEAL_REISSUE
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}