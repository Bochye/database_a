generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Accounts {
  id        Int      @id @default(autoincrement())
  userid    String
  password  String
  isadmin      Boolean  @default(false)
}

model Items{
  id        Int      @id @default(autoincrement())
  name    String
  userid    String
} 